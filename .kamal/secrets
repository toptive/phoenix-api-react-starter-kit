# Kamal secrets: references ONLY, never literal values (docs/DEPLOY.md).
# Values come from the macOS Keychain through `cred` (`cred add starter_kit/SECRET_KEY_BASE`).
# `tr` strips the trailing newline or space that breaks a key, a token or a Base64 value.
# A name without a value gives a blank secret, and the app treats a blank value as unset.
SECRET_KEY_BASE=$(cred get starter_kit/SECRET_KEY_BASE | tr -d '[:space:]')
DATABASE_URL=$(cred get starter_kit/DATABASE_URL | tr -d '[:space:]')
POSTMARK_API_KEY=$(cred get starter_kit/POSTMARK_API_KEY | tr -d '[:space:]')
SENTRY_DSN=$(cred get starter_kit/SENTRY_DSN | tr -d '[:space:]')
OPENROUTER_API_KEY=$(cred get starter_kit/OPENROUTER_API_KEY | tr -d '[:space:]')
FAL_KEY=$(cred get starter_kit/FAL_KEY | tr -d '[:space:]')
GOOGLE_API_KEY=$(cred get starter_kit/GOOGLE_API_KEY | tr -d '[:space:]')
GOOGLE_CLIENT_ID=$(cred get starter_kit/GOOGLE_CLIENT_ID | tr -d '[:space:]')
GOOGLE_CLIENT_SECRET=$(cred get starter_kit/GOOGLE_CLIENT_SECRET | tr -d '[:space:]')
S3_ACCESS_KEY_ID=$(cred get starter_kit/S3_ACCESS_KEY_ID | tr -d '[:space:]')
S3_SECRET_ACCESS_KEY=$(cred get starter_kit/S3_SECRET_ACCESS_KEY | tr -d '[:space:]')
POSTHOG_API_KEY=$(cred get starter_kit/POSTHOG_API_KEY | tr -d '[:space:]')

