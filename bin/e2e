#!/usr/bin/env bash
# Isolated browser gate, owned by the backend so the shared SPA stays portable.
set -euo pipefail
cd "$(dirname "$0")/.."
export MIX_ENV=test E2E=1
export MIX_BUILD_PATH="$PWD/_build/e2e"
export E2E_API_DIR="$PWD"
export E2E_PGDATABASE="${E2E_PGDATABASE:-starter_kit_e2e}"
export PORT="${E2E_PORT:-4100}"
export POOL_SIZE="${POOL_SIZE:-5}"
export ERL_FLAGS="${ERL_FLAGS:-+S 2:2}"
export E2E_API_URL="http://localhost:$PORT"
export SPA_ORIGIN="${E2E_BASE_URL:-http://localhost:5173}"
export E2E_AI=0 E2E_ADMIN=1 E2E_BILLING=0
if [ -f frontend/e2e/stripe-stub.mjs ]; then
  export E2E_BILLING=1
  export E2E_STRIPE_URL="${E2E_STRIPE_URL:-http://localhost:4200/v1/}"
fi
# Keep this run independent of configured external providers.
unset OPENROUTER_API_KEY FAL_KEY GOOGLE_API_KEY SENTRY_DSN MAIL_ALLOWED_RECIPIENTS
log_dir=$(mktemp -d "${TMPDIR:-/tmp}/phoenix-e2e.XXXXXX")
api_pid=""
cleanup() {
  status=$?
  trap - EXIT INT TERM
  if [ -n "$api_pid" ]; then
    kill "$api_pid" 2>/dev/null || true
    wait "$api_pid" 2>/dev/null || true
  fi
  if [ "$status" -ne 0 ]; then cat "$log_dir/api.log" 2>/dev/null || true; fi
  rm -rf "$log_dir"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if curl --silent --fail "$E2E_API_URL/health" >/dev/null; then
  echo "E2E port $PORT is already in use" >&2
  exit 1
fi
mix ecto.create --quiet
mix ecto.migrate --quiet
mix run --no-halt >"$log_dir/api.log" 2>&1 &
api_pid=$!
ready=false
for _ in {1..120}; do
  if ! kill -0 "$api_pid" 2>/dev/null; then break; fi
  if curl --silent --fail "$E2E_API_URL/health" >/dev/null; then ready=true; break; fi
  sleep 1
done
if [ "$ready" != true ]; then
  echo "E2E API failed to start" >&2
  exit 1
fi
pnpm e2e
