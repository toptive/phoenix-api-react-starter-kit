#!/usr/bin/env bash
# Claude Code PostToolUse hook (Edit|Write): checks the file Claude just changed.
# Exit 2 + stderr sends the failure back to Claude so it fixes the code at once.
set -uo pipefail
cd "${CLAUDE_PROJECT_DIR:-$(pwd)}"

file=$(node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).tool_input.file_path||"")}catch{console.log("")}})')
[ -z "$file" ] && exit 0
rel="${file#"$PWD"/}"

out=""
check() {
  local result
  if ! result=$("$@" 2>&1); then out+="$ $*"$'\n'"$result"$'\n\n'; fi
}

case "$rel" in
  lib/*.ex|lib/**/*.ex|credo/*.ex)
    check mix compile --warnings-as-errors
    check mix credo --strict "$rel"
    # Serializers, routes are the type contract: regenerate the TS.
    case "$rel" in
      lib/*_web/serializers/*|lib/*_web/router.ex|lib/*_web/controllers/*|lib/*_web/seo.ex)
        check mix typelizer.gen
        check mix typelizer.check
        ;;
    esac
    case "$rel" in
      lib/*_web/controllers/*|lib/*_web/router.ex|lib/*/workers/*|lib/*_worker.ex) check mix test test/architecture ;;
    esac
    ;;
  test/*.exs|test/**/*.exs|config/*.exs)
    check mix format --check-formatted "$rel"
    ;;
  frontend/src/api/generated/*)
    # Generated by typelizer: never edited by hand. Any change shows up as drift.
    check mix typelizer.check
    ;;
  frontend/src/*.ts|frontend/src/*.tsx|frontend/src/**/*.ts|frontend/src/**/*.tsx)
    check pnpm exec eslint --config frontend/eslint.config.js --max-warnings 0 --no-warn-ignored "$rel"
    ;;
  i18n/translations.csv)
    check pnpm i18n:build
    check mix test test/architecture/frontend_test.exs test/starter_kit/i18n_test.exs
    ;;
  frontend/eslint.config.js|frontend/tsconfig.json)
    check pnpm lint
    ;;
esac

if [ -n "$out" ]; then
  printf "architecture-check failed for %s — fix the code, not the rule:\n\n%s" "$rel" "$out" >&2
  exit 2
fi
exit 0
