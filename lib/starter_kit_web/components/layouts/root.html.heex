<!DOCTYPE html>
<html lang={assigns[:locale] || "en"} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta :if={!assigns[:public_anonymous]} name="csrf-token" content={get_csrf_token()} />
    <meta
      :if={!assigns[:indexable] or !StarterKitWeb.Plugs.SiteIndexing.enabled?()}
      name="robots"
      content="noindex"
    />
    <meta name="theme-color" content={Application.get_env(:starter_kit, :theme_color, "#11694F")} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <.inertia_title>{page_title(assigns)}</.inertia_title>
    <.inertia_head content={@inertia_head} />
    <script nonce={assigns[:csp_nonce]}>
      (function () {
        try {
          var a = localStorage.getItem("appearance");
          var dark = a === "dark" || (a !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
          document.documentElement.style.colorScheme = dark ? "dark" : "light";
        } catch (_) {}
      })();
    </script>
    {raw(StarterKitWeb.Vite.tags(assigns[:csp_nonce]))}
  </head>
  <body class="h-full">
    {@inner_content}
  </body>
</html>
